---
import Layout from "@/layouts/Layout.astro";
import {Footer} from "@/components/footer.tsx";
import HeroSchool from "@/components/HeroSchool.astro";
import {
    CheckCircle2,
    ArrowRight,
    ShieldCheck,
    Heart,
    MapPin,
    Mail,
    Phone,
    Trophy,
    Users,
    Sparkles,
    Target
} from "lucide-react";
---

<Layout
        title="Progetto scuole | Black Bulls Volley ASD"
        description="Vivi la pallavolo con i Black Bulls Volley di Cologno Monzese. Passione, crescita e spirito di squadra dal settore giovanile alla Serie D."
>
    <main class="overflow-hidden bg-slate-950 text-white w-full">
        <HeroSchool/>

        <section class="relative py-24 overflow-hidden border-t border-slate-800/60 bg-slate-950">
            <div class="absolute top-1/4 left-0 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute bottom-10 right-0 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

                    <div class="lg:col-span-7 space-y-8">
                        <div class="space-y-4">
                            <span class="inline-flex items-center gap-2 text-red-500 font-bold uppercase tracking-widest text-xs bg-red-500/10 px-3 py-1 rounded-full border border-red-500/20">
                                <Sparkles class="w-3.5 h-3.5"/>
                                Vantaggi esclusivi Progetto Scuole
                            </span>
                            <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white uppercase leading-[1.05]">
                                Il tuo pass per entrare in <span class="text-red-600">squadra</span>
                            </h2>
                            <p class="text-slate-400 text-base sm:text-lg font-medium leading-relaxed">
                                Approfitta dei vantaggi riservati agli studenti del progetto scolastico per iniziare il
                                tuo percorso nella pallavolo con i Black Bulls.
                            </p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800/80 flex items-center gap-4 shadow-lg">
                                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-red-600/20 text-red-500 flex items-center justify-center font-bold">
                                    <CheckCircle2 class="w-6 h-6"/>
                                </div>
                                <div>
                                    <span class="block text-xs uppercase tracking-wider text-slate-400 font-semibold">Esperienza</span>
                                    <span class="text-base font-bold text-white">2 prove gratuite</span>
                                </div>
                            </div>

                            <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800/80 flex items-center gap-4 shadow-lg">
                                <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-red-600/20 text-red-500 flex items-center justify-center font-bold">
                                    <CheckCircle2 class="w-6 h-6"/>
                                </div>
                                <div>
                                    <span class="block text-xs uppercase tracking-wider text-slate-400 font-semibold">Agevolazione</span>
                                    <span class="text-base font-bold text-white">20% di sconto iscrizione</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <a
                                    href="#contatti"
                                    class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 bg-red-600 text-white font-bold text-sm uppercase tracking-wider rounded-xl hover:bg-red-700 transition-all shadow-xl shadow-red-600/30 active:scale-95 group"
                            >
                                <span>Scarica il coupon</span>
                                <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1"/>
                            </a>
                            <p class="text-xs text-slate-500 mt-3 font-medium">
                                * Riservato ai nuovi iscritti del Progetto Scuole Cologno Monzese.
                            </p>
                        </div>
                    </div>

                    <div class="lg:col-span-5">
                        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-8 space-y-6 shadow-2xl backdrop-blur-md relative">
                            <div class="flex items-center gap-4 border-b border-slate-800 pb-5">
                                <div class="w-12 h-12 rounded-2xl bg-red-600/10 flex items-center justify-center text-red-500 shrink-0">
                                    <ShieldCheck class="w-6 h-6"/>
                                </div>
                                <div>
                                    <h3 class="font-black text-white text-lg tracking-wide uppercase">Black Bulls
                                        Volley</h3>
                                    <p class="text-xs text-slate-400 font-medium">Cologno Monzese (MI)</p>
                                </div>
                            </div>

                            <div class="space-y-4 text-sm text-slate-300 font-medium">
                                <div class="flex items-center gap-3.5">
                                    <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-red-500 shrink-0">
                                        <MapPin class="w-4 h-4"/>
                                    </div>
                                    <span>Via Leonardo Da Vinci, 1 - Cologno M.se</span>
                                </div>
                                <div class="flex items-center gap-3.5">
                                    <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-red-500 shrink-0">
                                        <Phone class="w-4 h-4"/>
                                    </div>
                                    <span>351 750 6557</span>
                                </div>
                                <div class="flex items-center gap-3.5">
                                    <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-red-500 shrink-0">
                                        <Mail class="w-4 h-4"/>
                                    </div>
                                    <span>cblackbullsvolley@gmail.com</span>
                                </div>
                            </div>

                            <div class="pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400 font-semibold">
                                <span class="flex items-center gap-1.5">
                                    <Heart class="w-4 h-4 text-red-500"/>
                                    Dal 2010 sul campo
                                </span>
                                <span class="uppercase tracking-widest text-red-500">ASD</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <section class="py-20 bg-slate-950 border-t border-slate-800/60 relative">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
                    <span class="text-red-500 font-bold uppercase tracking-widest text-xs">Crescita e Sport</span>
                    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white">Un percorso pensato
                        per i giovani</h2>
                    <p class="text-slate-400 text-base sm:text-lg">
                        Dalle prime esperienze ludiche a scuola fino ai campionati agonistici, accompagniamo ogni
                        ragazzo nella sua evoluzione sportiva.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="bg-slate-900/80 border border-slate-800 p-8 rounded-3xl space-y-4 shadow-lg hover:border-red-600/50 transition-all">
                        <div class="w-12 h-12 rounded-2xl bg-red-600/10 flex items-center justify-center text-red-500 font-bold">
                            <Target class="w-6 h-6"/>
                        </div>
                        <h3 class="text-xl font-bold text-white uppercase tracking-wide">Minivolley</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            Avviamento allo sport basato sul gioco, sul movimento e sullo sviluppo delle capacità
                            coordinative di base.
                        </p>
                    </div>

                    <div class="bg-slate-900/80 border border-slate-800 p-8 rounded-3xl space-y-4 shadow-lg hover:border-red-600/50 transition-all">
                        <div class="w-12 h-12 rounded-2xl bg-red-600/10 flex items-center justify-center text-red-500 font-bold">
                            <Users class="w-6 h-6"/>
                        </div>
                        <h3 class="text-xl font-bold text-white uppercase tracking-wide">Settore Giovanile</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            Allenamenti mirati per far crescere i ragazzi, dentro e fuori dal campo.
                        </p>
                    </div>

                    <div class="bg-slate-900/80 border border-slate-800 p-8 rounded-3xl space-y-4 shadow-lg hover:border-red-600/50 transition-all">
                        <div class="w-12 h-12 rounded-2xl bg-red-600/10 flex items-center justify-center text-red-500 font-bold">
                            <Trophy class="w-6 h-6"/>
                        </div>
                        <h3 class="text-xl font-bold text-white uppercase tracking-wide">Prima Squadra / Serie D</h3>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            l punto d'arrivo di un percorso fatto insieme, la spinta che unisce chi scende in campo e chi fa il tifo sugli spalti.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-slate-950 text-white border-t  border-slate-950">
        <Footer/>
    </footer>
</Layout>